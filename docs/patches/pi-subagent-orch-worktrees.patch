+	/** Set when orch created the worktree; it removes it through the same hook. */
+	orch?: OrchHook;
+}
+
+/** How to reach `orch worktree-hook` for a worktree orch owns. */
+export interface OrchHook {
+	bin: string;
+	sessionWorktree: string;
+}
+
+function realpathOrSelf(p: string): string {
+	try {
+		return fs.realpathSync(p);
+	} catch {
+		return p;
+	}
+}
+
+/**
+ * When pi runs in an orch Session (ORCH_BIN and ORCH_WORKTREE set) from the
+ * Session's Worktree, orch makes and removes Subagent worktrees so they live
+ * inside the Session's Sandbox and show up in orch's per-Subagent Review.
+ */
+export function orchHookFor(repoRoot: string): OrchHook | undefined {
+	const bin = process.env.ORCH_BIN;
+	const sessionWorktree = process.env.ORCH_WORKTREE;
+	if (!bin || !sessionWorktree) return undefined;
+	if (realpathOrSelf(repoRoot) !== realpathOrSelf(sessionWorktree)) return undefined;
+	return { bin, sessionWorktree };
+}
+
+function orchHookArgs(hook: OrchHook): string[] {
+	return ["worktree-hook", "--agent", "pi", "--worktree", hook.sessionWorktree];
+}
+
+function runOrchHook(hook: OrchHook, payload: object): Promise<ExecResult> {
+	return new Promise((resolve) => {
+		const proc = spawn(hook.bin, orchHookArgs(hook), { stdio: ["pipe", "pipe", "pipe"] });
+		let stdout = "";
+		let stderr = "";
+		proc.stdout.on("data", (d) => {
+			stdout += d.toString();
+		});
+		proc.stderr.on("data", (d) => {
+			stderr += d.toString();
+		});
+		proc.on("close", (code) => resolve({ code: code ?? 0, stdout, stderr }));
+		proc.on("error", (err) => resolve({ code: 1, stdout, stderr: stderr + String(err) }));
+		proc.stdin.on("error", () => {});
+		proc.stdin.end(JSON.stringify(payload));
+	});
+}
+
+/** Ask orch to remove one of its worktrees; returns an error message or undefined. */
+export async function orchRemoveWorktree(hook: OrchHook, worktreePath: string): Promise<string | undefined> {
+	const r = await runOrchHook(hook, { event: "worktree_remove", path: worktreePath });
+	return r.code === 0
+		? undefined
+		: `orch worktree-hook failed to remove ${worktreePath} (exit ${r.code}): ${r.stderr.trim() || r.stdout.trim()}`;
 }
 
